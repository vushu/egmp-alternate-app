# Bluewink — systemd service (run the Node server in the background)
#
# Install:
#   sudo cp deploy/bluewink.service /etc/systemd/system/bluewink.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bluewink
#
# Logs:
#   journalctl -u bluewink -f
#
# After changing the app code:
#   cd /path/to/egmp-alternate-app && npx expo export --platform web
#   sudo systemctl restart bluewink

[Unit]
Description=Bluewink web server (Hyundai/Kia EV companion app)
After=network.target

[Service]
Type=simple
# ← change to where you cloned the repo:
WorkingDirectory=/opt/egmp-alternate-app
# Zero-dependency plain-JS server — no npm install needed on the server.
# (scripts/serve-web.ts is the TypeScript original for development.)
ExecStart=/usr/bin/node scripts/serve-web.mjs

# Password protection (REQUIRED for a public server):
# Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(c.scryptSync(process.argv[1],s,64).toString('hex')+':'+s.toString('hex'))" 'YOUR_PASSWORD'
Environment=BLUEWINK_PASSWORD_HASH=<paste hash here>

# Stable sessions across restarts (generate with: openssl rand -hex 32):
Environment=BLUEWINK_SESSION_SECRET=<paste random hex here>

# Optional: change port (must match nginx proxy_pass):
# Environment=PORT=3000

# Web base path — must match what the bundle was built with
# (BLUEWINK_BASE_PATH at export time). Default: / (domain root).
# Environment=BLUEWINK_BASE_PATH=/bil/kona

Restart=always
RestartSec=5
User=www-data
Group=www-data

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/egmp-alternate-app
[Install]
WantedBy=multi-user.target
